# Copy this file to .env and fill in ONE provider's key.

# ---- Option A (default): Groq - free key at https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b        # default; alternative: llama-3.3-70b-versatile

# ---- Option B: Google Gemini - free key at https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# LLM_MODEL=gemini-flash-lite-latest

# ---- Option C: local model with Ollama (no key, needs `pip install langchain-ollama`)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# Password for the "Security officer" login tab. Change it before showing the app to anyone.
OFFICER_PASSWORD=officer123

# Internal token the dashboard uses for officer-only MCP tools (any long random text).
OFFICER_TOKEN=change-me-officer-token

# Lost reports are auto-notified when a found item scores at least this (0-100).
AUTO_NOTIFY_THRESHOLD=70
